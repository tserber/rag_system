# Copy this file to .env and fill in the values you need.
# Everything here maps directly to src/rag_core/config.py:Settings

# --- Qdrant: local (default) or cloud ---
QDRANT_MODE=local
QDRANT_COLLECTION=rag_documents

QDRANT_LOCAL_HOST=localhost
QDRANT_LOCAL_PORT=6333

# Only used when QDRANT_MODE=cloud (https://qdrant.tech/pricing/ free tier: 1GB RAM / 4GB disk)
QDRANT_CLOUD_URL=
QDRANT_CLOUD_API_KEY=

# --- Embeddings (always local/free) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Chunking ---
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=120

# --- Retrieval ---
TOP_K=3

# --- Generation: retrieval_only (default) or ollama ---
GENERATION_MODE=retrieval_only
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
